# Copy to `.env` and fill in what you need. Everything is optional:
# the default pipeline (offline local index + in-process 'memory' chain) needs
# none of these.

# ---- Live web / social-media reverse image search (optional) ----
# Free-tier key from https://serpapi.com  (enables --provider serpapi / auto).
SERPAPI_KEY=

# ---- Blockchain selection ----
# memory | rpc | sepolia   (default: memory, an in-process EVM, zero setup)
FACECHAIN_CHAIN=memory

# Local JSON-RPC dev node for --chain rpc (ganache / anvil / hardhat).
RPC_URL=http://127.0.0.1:8545
# Deterministic dev mnemonic used to derive a signer when PRIVATE_KEY is unset.
# Matches:  npx ganache --wallet.mnemonic "<this>"    and anvil/hardhat default.
DEV_MNEMONIC=test test test test test test test test test test test junk

# Public Sepolia testnet for --chain sepolia (Alchemy/Infura URL).
SEPOLIA_RPC_URL=
# Funded testnet account private key (0x...). NEVER commit a real key.
PRIVATE_KEY=

# ---- Tunables (optional) ----
# FACECHAIN_FACE_THRESHOLD=0.363
# FACECHAIN_SEARCH_THRESHOLD=0.30
# SOLC_VERSION=0.8.24
